DATABASE_URL=postgresql://voyara:voyara@localhost:5432/voyara_db
HOST=127.0.0.1
PORT=3000

# Local development, server-side tools, and automated tests only.
# Never put this token in a browser frontend, commit a real value, or treat it as customer authentication.
# Generate one with: openssl rand -hex 32
VOYARA_DEV_ACCESS_TOKEN=

# Server-side only. Never commit a real key or place it in a browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NOVA_TIMEOUT_MS=20000
